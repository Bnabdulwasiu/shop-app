# Copy to `.env` (git-ignored) and fill in. Same values as web `.env.local`.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-OR-PUBLISHABLE-KEY
# Deployed web URL (physical phone cannot reach localhost).
# e.g. https://shop-app-kappa-coral.vercel.app
EXPO_PUBLIC_API_URL=https://shop-app-kappa-coral.vercel.app
