# ---------------------------------------------------------------------------
# TEMPLATE ONLY — never put real keys in this file.
# This file IS committed to git, so it must stay placeholders.
# Real values belong in `.env.local` (git-ignored via .env*).
#
# Supabase Dashboard -> Project Settings -> API
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-OR-PUBLISHABLE-KEY

# Server-only. NEVER expose this to the browser.
# Newer Supabase projects call this the "secret key" (sb_secret_...);
# older ones call it the service_role key. Either works.
# Used for trusted writes (orders, order_items, stock, cart cleanup).
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-OR-SECRET-KEY

# Public base URL of this app (used for OAuth redirects and links in emails).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Mailgun — order confirmation emails
# Dashboard -> Send -> Domains (domain) and Dashboard -> API keys (private key).
# ---------------------------------------------------------------------------
MAILGUN_API_KEY=YOUR-MAILGUN-PRIVATE-API-KEY
MAILGUN_DOMAIN=sandbox000000000000000000000000000000.mailgun.org
MAILGUN_FROM=Shop <postmaster@YOUR-MAILGUN-DOMAIN>

# Only if your Mailgun domain is in the EU region:
# MAILGUN_URL=https://api.eu.mailgun.net